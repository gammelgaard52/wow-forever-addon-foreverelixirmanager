import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"

-- Synthetic data for an emulator probe, not evidence of actual Forever item data.
@test("bag event refreshes the queued item")
local function bags()
    mock.defineItem(2458, { name = "Elixir of Minor Fortitude", minLevel = 1 })
    mock.setBag(0, { slots = 16, items = { [1] = { id = 2458, count = 2 } } })
    mock.advanceTime(1)
    expect(_G["ForeverElixirSecureBtn"]:GetAttribute("item")).toBe("item:2458")
    expect(mock.errors()).toEqual({})
end
